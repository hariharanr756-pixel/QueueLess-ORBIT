# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external Python FastAPI + Random Forest prediction service URL
FASTAPI_PREDICT_URL=

# Optional PostgreSQL connection string for replaceable data layer
DATABASE_URL=

# Optional Firebase Web Config (used only if Firebase is configured)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Supabase Backend Integration (server-side only; configure in AI Studio Secrets or .env)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

